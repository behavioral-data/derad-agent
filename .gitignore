# Claude Code: ignore everything under .claude/ (session scratch, analysis
# notes, personal settings, infra-coupled skills) EXCEPT the committed
# project config. New scratch files are ignored automatically; to add new
# project config, extend the allowlist below or `git add -f`.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Internal project tracking — not for public consumption
todo.md

# mock-x study interface — generated, read-only DB artifact
study/data/study.db

# Manuscript working copy — not part of the code artifact
paper/

# Playwright MCP browser scratch
.playwright-mcp/

